# Account panel settings. Copy this file to .env.local (gitignored) and fill it in
# for local use; on Vercel, enter the same four names under
# Project → Settings → Environment Variables. Never commit the filled-in copy.

# Supabase → Connect → Direct → Transaction pooler (port 6543), type URI.
# Replace YOUR-DATABASE-PASSWORD with the database password — no square brackets.
# Letters and numbers only is safest; an @ in the password must be written %40.
DATABASE_URL=postgresql://postgres.pgjqooqeamvftzdghaay:YOUR-DATABASE-PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Who may sign in to the panel, comma-separated.
ADMIN_EMAILS=aiteamrizvizfaisaltown@gmail.com

# A long random string that signs the admin sign-in cookie. In PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
SESSION_SECRET=

# A long random string the installed apps send to prove they are Scraping Hub.
# Must equal SCRAPING_HUB_API_KEY in server/.env (which goes into the credentials file).
HUB_API_KEY=
